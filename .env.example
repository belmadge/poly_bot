# Wallet
PK=

# Fixed market
TOKEN_ID=

# Strategy
SPREAD=0.02
SIZE=10
LOOP_INTERVAL_SECONDS=300
TICK_SIZE=0.01
PRICE_TOLERANCE=0.0001
REPOSITION_PRICE_THRESHOLD=0.001

# Balance and risk
MIN_COLLATERAL_BUFFER=1.0
MAX_BALANCE_USAGE_PCT=0.9
MIN_BALANCE_THRESHOLD=10.0

# Safety
MIN_PRICE_BOUND=0.05
MAX_PRICE_BOUND=0.95
MAX_BOOK_SPREAD_PCT=0.02
MAX_MIDPOINT_DEVIATION_RATIO=0.25
MAX_SYNC_AGE_SECONDS=60.0
MIN_OPERABLE_SPREAD=0.01
MAX_OPERABLE_SPREAD=0.20
MAX_CANCELS_PER_MINUTE=6
PAUSE_AFTER_CANCEL_LIMIT_SECONDS=60
MAX_ORDER_AGE_SECONDS=300
MAX_ORDERS_PER_CYCLE=2
MIN_LIQUIDITY_SCORE=100
MAX_VOLATILITY_RATIO=0.05
FEE_RATE=0.0015
ESTIMATED_SLIPPAGE_RATE=0.001
MIN_PROFIT_MARGIN=0.0025
INVENTORY_TARGET=0
INVENTORY_SOFT_LIMIT=25
INVENTORY_PRICE_ADJUSTMENT=0.003
PROTECTION_NO_FILL_CYCLES=4
PROTECTION_ERROR_STREAK=2
