# Polymarket CLOB API base URL
POLYMARKET_HOST=https://clob.polymarket.com

# Chain (137 = Polygon mainnet, 80002 = Amoy)
CHAIN_ID=137

# Wallet private key (hex, sem 0x)
PK=

# Market outcome token ID
TOKEN_ID=
TOKEN_IDS=

# Bot params
SPREAD=0.02
SIZE=10
LOOP_INTERVAL_SECONDS=300
TICK_SIZE=0.01

# Selecao automatica de mercado / spread dinamico
AUTO_SELECT_MARKET=true
MARKET_SCAN_LIMIT=25
DYNAMIC_SPREAD_ENABLED=true
MIN_SPREAD=0.02
MAX_SPREAD=0.04
LIQUIDITY_TARGET_LOW=10
LIQUIDITY_TARGET_HIGH=50

# Tolerância para identificar ordem duplicada (price/size)
PRICE_TOLERANCE=0.0001

# Margem extra de collateral exigida antes do BUY
MIN_COLLATERAL_BUFFER=1.0

# Controle de posicao
TARGET_POSITION_SIZE=0
MAX_POSITION_IMBALANCE=10

# Retry / resiliência
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Logging estruturado
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: set L2 credentials to avoid re-deriving API key each startup
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
