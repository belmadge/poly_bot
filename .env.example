# API
POLYMARKET_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Wallet
PK=

# Fixed market
TOKEN_ID=

# Strategy
SPREAD=0.02
SIZE=10
LOOP_INTERVAL_SECONDS=300
TICK_SIZE=0.01
PRICE_TOLERANCE=0.0001
REPOSITION_PRICE_THRESHOLD=0.001

# Balance and risk
MIN_COLLATERAL_BUFFER=1.0
MAX_BALANCE_USAGE_PCT=0.9
MIN_BALANCE_THRESHOLD=10.0

# Safety
MIN_PRICE_BOUND=0.05
MAX_PRICE_BOUND=0.95
MAX_BOOK_SPREAD_PCT=0.02
MAX_MIDPOINT_DEVIATION_RATIO=0.25
MAX_SYNC_AGE_SECONDS=60.0
DRY_RUN=true

# Resilience
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
MAX_CONSECUTIVE_ERRORS=5
MAX_API_FAILURE_STREAK=3
KILL_SWITCH_FLAG_FILE=.kill_switch

# Logging and state
LOG_LEVEL=INFO
LOG_FORMAT=text
STATE_FILE=bot_state.json

# Optional L2 credentials
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
