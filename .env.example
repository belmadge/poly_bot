# Polymarket CLOB API base URL
POLYMARKET_HOST=https://clob.polymarket.com

# Chain (137 = Polygon mainnet, 80002 = Amoy)
CHAIN_ID=137

# Wallet private key (hex, sem 0x)
PK=

# Market outcome token ID
TOKEN_ID=
TOKEN_IDS=

# Bot params
SPREAD=0.02
SIZE=10
LOOP_INTERVAL_SECONDS=300
TICK_SIZE=0.01

# Selecao automatica de mercado / spread dinamico
AUTO_SELECT_MARKET=true
MARKET_SCAN_LIMIT=25
DYNAMIC_SPREAD_ENABLED=true
MIN_SPREAD=0.02
MAX_SPREAD=0.04
LIQUIDITY_TARGET_LOW=10
LIQUIDITY_TARGET_HIGH=50
LOW_VOLATILITY_THRESHOLD=0.002
HIGH_VOLATILITY_THRESHOLD=0.01
LOW_VOLATILITY_SPREAD_MULTIPLIER=0.85
HIGH_VOLATILITY_SPREAD_MULTIPLIER=1.4

# Tolerância para identificar ordem duplicada (price/size)
PRICE_TOLERANCE=0.0001
PRICE_REFRESH_THRESHOLD=0.01

# Margem extra de collateral exigida antes do BUY
MIN_COLLATERAL_BUFFER=1.0

# Controle de posicao
TARGET_POSITION_SIZE=0
MAX_POSITION_IMBALANCE=10
MAX_POSITION_SIZE=10
MAX_BALANCE_USAGE_PCT=0.9

# Retry / resiliência
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Logging no terminal
LOG_LEVEL=INFO
LOG_FORMAT=text

# Estado local do bot
STATE_FILE=bot_state.json

# KILL SWITCH: Safety mechanisms
# Max consecutive errors before stopping bot
MAX_CONSECUTIVE_ERRORS=5
# Minimum balance threshold (if balance drops below, bot stops)
MIN_BALANCE_THRESHOLD=10.0
# Max consecutive API failures before stopping bot
MAX_API_FAILURE_STREAK=3
# Path to kill switch flag file (if exists, bot stops)
KILL_SWITCH_FLAG_FILE=.kill_switch

# REPOSITIONING: Order churn reduction
# Price change threshold to trigger order repositioning (0.001 = 0.1%)
REPOSITION_PRICE_THRESHOLD=0.001

# PERFORMANCE: Metrics logging
# Interval in seconds to log performance metrics
METRICS_LOG_INTERVAL_SECONDS=3600

# SAFE HEDGE
HEDGE_MIN_POSITION_SIZE=5.0
HEDGE_DELAY_SECONDS=30.0

# PRICE SANITY
MIN_PRICE_BOUND=0.05
MAX_PRICE_BOUND=0.95
MAX_BOOK_SPREAD_PCT=0.02
MAX_MIDPOINT_DEVIATION_RATIO=0.25

# HARD SYNC
MAX_SYNC_AGE_SECONDS=60.0

# Optional: set L2 credentials to avoid re-deriving API key each startup
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
